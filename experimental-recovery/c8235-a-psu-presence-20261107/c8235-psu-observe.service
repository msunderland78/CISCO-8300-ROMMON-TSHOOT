[Unit]
Description=Temporary C8235-A read-only PSU library observer
DefaultDependencies=no
IgnoreOnIsolate=yes
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/bin/bash /c8235-psu-observe-launch.sh --live --confirmed-chassis FGL2835L42B
RuntimeMaxSec=180
