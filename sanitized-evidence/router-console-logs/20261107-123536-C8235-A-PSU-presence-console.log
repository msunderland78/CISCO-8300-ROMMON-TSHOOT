[Unit]
Description=Mount packages
DefaultDependencies=no

Conflicts=shutdown.target
Before=shutdown.target

Requires=launch_net.service find_debugconf.service
After=launch_net.service find_debugconf.service
Requires=rmon_vars.service
After=rmon_vars.service

Before=basic.target initrd-parse-etc.service


[Service]
ExecStart=/mount_packages.sh
# for failures in initrd attempt to save logs on way down
ExecStop=/umount_packages.sh
Type=oneshot
Restart=no
TimeoutSec=60
RemainAfterExit=yes

[Install]
RequiredBy=basic.target
